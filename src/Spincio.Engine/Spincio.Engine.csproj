<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure rules engine: ZERO package or project dependencies (see CLAUDE.md). -->
  <PropertyGroup>
    <RootNamespace>Spincio.Engine</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <!-- CA1716: "Declare" is a VB keyword; the engine is consumed from C# only and the name comes from SPEC section 3. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Spincio.Engine.Tests" />
  </ItemGroup>
</Project>
