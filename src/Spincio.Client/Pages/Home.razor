@page "/"
@using Spincio.Client.Game
@implements IDisposable
@inject GameHost Host
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject SettingsService Settings
@inject StatsService Stats

<PageTitle>Spincio</PageTitle>

@if (!Session.IsStarted)
{
    <section class="start menu-screen">
        <div class="logo" aria-hidden="true">
            <div class="fan">
                <img src="cards/AD.webp" alt="" />
                <img src="cards/7D.webp" alt="" />
                <img src="cards/KD.webp" alt="" />
            </div>
        </div>
        <h1 class="title">Spincio</h1>
        <p class="tagline">2 contro 2 · mazzo piacentino · si vince a 31</p>
        <div class="menu-buttons">
            @if (_hasSave)
            {
                <button type="button" class="btn btn-gold" @onclick="ResumeAsync">Riprendi la partita</button>
            }
            <button type="button" class="btn @(_hasSave ? "btn-green" : "btn-gold")" @onclick="NewGameAsync">
                Nuova partita
                <small>CPU @(_settings.Difficulty == BotLevel.Pimc ? "difficile" : "normale")</small>
            </button>
            @if (!string.IsNullOrWhiteSpace(Configuration["ServerUrl"]))
            {
                <a class="btn btn-green" href="online">Gioca online con gli amici</a>
            }
            <button type="button" class="btn btn-dark" @onclick="() => _rulesOpen = true">📖 Regole</button>
            <button type="button" class="btn btn-dark" @onclick="() => _statsOpen = true">📊 Statistiche</button>
            <button type="button" class="btn btn-dark" @onclick="() => _optionsOpen = true">⚙ Opzioni</button>
        </div>
        <p class="app-version">v@(AppInfo.Version)</p>
    </section>
}
else
{
    var view = Session.View;
    var me = Session.Me;
    var us = me.Team;
    var legal = Session.LegalCommands;
    var highlighted = _choices.SelectMany(c => c.Capture?.Cards ?? []).ToHashSet();
    // While the round summary is open, the end-of-round points have not flown in yet: they land when it closes.
    var score = Session.PendingSummary is { } pending ? PointsGain.ScoreBefore(pending) : view.Score;

    <header class="scorebar">
        <button type="button" class="icon-btn" aria-label="Menu" @onclick="() => _menuOpen = true">☰</button>
        <div class="score"><span>Noi</span><strong>@score.For(us)</strong></div>
        <div class="info">
            @(view.MatchNumber > 0 ? $"Spareggio {view.MatchNumber} · " : "")Smazzata @view.RoundNumber · Mazzo @view.DeckCount
        </div>
        <div class="score"><span>Loro</span><strong>@score.For(GameText.Other(us))</strong></div>
    </header>

    <main class="board">
        @SeatAt(view, 2)
        <div class="middle">
            @SeatAt(view, 3)
            <div class="table" aria-label="Tavola" style="@TableFit(view.Table.Length)">
                @if (view.Table.IsEmpty)
                {
                    <span class="empty">Tavola vuota</span>
                }
                @foreach (var card in view.Table)
                {
                    <CardView @key="card" Card="card" Highlighted="highlighted.Contains(card)" />
                }
            </div>
            @SeatAt(view, 1)
        </div>

        <details class="feed">
            <summary aria-live="polite">@(Session.Feed.Count > 0 ? Session.Feed[^1] : "Storico delle mosse")</summary>
            <ol reversed>
                @for (var i = Session.Feed.Count - 2; i >= 0; i--)
                {
                    <li>@Session.Feed[i]</li>
                }
            </ol>
        </details>

        <section class="me @(view.IsMyTurn ? "turn" : "")">
            <div class="status">
                @if (view.IsMyTurn)
                {
                    <span>Tocca a te @(view.Dealer == me ? "· sei il mazziere" : "")</span>
                }
                else if (view.Phase == MatchPhase.AwaitingPlay)
                {
                    <span>Tocca a @Session.SeatName(view.ToPlay)…</span>
                }
                @foreach (var d in view.Declarations.Where(d => d.Seat == me))
                {
                    <span class="badge">@GameText.DeclarationName(d.Kind) +@d.Points</span>
                }
                @if (legal.OfType<Declare>().Any())
                {
                    <button type="button" class="declare" @onclick="() => Session.PlayAsync(new Declare(me))">
                        Accusa: @GameText.DeclarationName(view.AvailableDeclaration.Kind) (+@view.AvailableDeclaration.Points)
                    </button>
                }
            </div>

            <div class="hand">
                @foreach (var card in view.Hand)
                {
                    <CardView @key="card" Card="card" Playable="CanPlay(legal, card)" Highlighted="_choosing == card" OnClick="OnCardClickAsync" />
                }
            </div>

            @if (Session.Error is { } error)
            {
                <p class="error">@error</p>
            }
        </section>
    </main>

    @if (Session.BannerCount > 0 && Session.BannerCount != _bannersAtStart)
    {
        <div class="sweep-flash" @key="Session.BannerCount" aria-hidden="true">@Session.BannerText</div>
    }

    @if (_choosing is { } chosen)
    {
        <div class="overlay" role="dialog" aria-modal="true" aria-labelledby="choice-title">
            <div class="panel game-panel">
                <header class="panel-head">
                    <h2 id="choice-title">Cosa prendi con @GameText.CardName(chosen)?</h2>
                    <button type="button" class="close" aria-label="Annulla" @onclick="CancelChoice">✕</button>
                </header>
                @foreach (var option in _choices)
                {
                    <button type="button" class="choice" @onclick="() => ChooseAsync(option)">
                        @foreach (var card in option.Capture!.Cards)
                        {
                            <CardView Card="card" />
                        }
                    </button>
                }
                <button type="button" class="btn btn-dark" @onclick="CancelChoice">Annulla</button>
            </div>
        </div>
    }

    @if (Session.PendingSummary is { } scored)
    {
        @if (!_landingPoints)
        {
            <RoundSummary Scored="scored" Us="us" OnClose="CloseSummaryAsync" />
        }
    }
    else if (Session.Result is { } result)
    {
        <div class="overlay" role="dialog" aria-modal="true" aria-labelledby="result-title">
            <div class="panel game-panel result @(result.Winner == us ? "won" : "lost")">
                <header class="panel-head">
                    <h2 id="result-title">@(result.Winner == us ? "Avete vinto!" : "Hanno vinto loro")</h2>
                </header>
                <p class="final-score"><span>Noi <strong>@result.FinalScore.For(us)</strong></span><span>Loro <strong>@result.FinalScore.For(GameText.Other(us))</strong></span></p>
                <p class="reason">Vittoria per @GameText.WinReasonText(result.Reason)</p>
                @if (Session.CanRestart)
                {
                    <button type="button" class="btn btn-gold" @onclick="NewGameAsync">Nuova partita</button>
                }
                <button type="button" class="btn btn-dark" @onclick="LeaveAsync">Menu principale</button>
            </div>
        </div>
    }

    @if (_menuOpen)
    {
        <div class="overlay" role="dialog" aria-modal="true" aria-labelledby="menu-title">
            <div class="panel game-panel">
                <header class="panel-head">
                    <h2 id="menu-title">@(_confirmLeave ? "Abbandonare la partita?" : "Pausa")</h2>
                    <button type="button" class="close" aria-label="Chiudi" @onclick="CloseMenu">✕</button>
                </header>
                @if (_confirmLeave)
                {
                    <p>@(Session.CanRestart ? "La partita in corso andrà persa." : "Lasci la stanza: al tuo posto giocherà la CPU.")</p>
                    <button type="button" class="btn btn-red" @onclick="LeaveAsync">@(Session.CanRestart ? "Sì, abbandona" : "Sì, esci")</button>
                    <button type="button" class="btn btn-dark" @onclick="() => _confirmLeave = false">No, torna al menu</button>
                }
                else
                {
                    <button type="button" class="btn btn-gold" @onclick="CloseMenu">Riprendi</button>
                    <button type="button" class="btn btn-green" @onclick="() => _rulesOpen = true">📖 Regole</button>
                    <button type="button" class="btn btn-green" @onclick="() => _statsOpen = true">📊 Statistiche</button>
                    <button type="button" class="btn btn-green" @onclick="() => _optionsOpen = true">⚙ Opzioni</button>
                    <button type="button" class="btn btn-red" @onclick="() => _confirmLeave = true">@(Session.CanRestart ? "Abbandona la partita" : "Esci dalla stanza")</button>
                    <p class="menu-info">@Session.Footer</p>
                    <p class="app-version">Spincio v@(AppInfo.Version)</p>
                }
            </div>
        </div>
    }
}

@if (_rulesOpen)
{
    <RulesPanel OnClose="() => _rulesOpen = false" />
}

@if (_statsOpen)
{
    <StatsPanel OnClose="() => _statsOpen = false" />
}

@if (_optionsOpen)
{
    <OptionsPanel Settings="_settings" SettingsChanged="SaveSettingsAsync" OnClose="() => _optionsOpen = false" />
}

@code {
    /// <summary>Optional <c>?seed=</c> to replay a specific deal (bug reports, tests).</summary>
    [SupplyParameterFromQuery(Name = "seed")] public string? SeedParameter { get; set; }

    private IGameSession Session => Host.Current;
    private IGameSession? _subscribed;
    private IMoveAnimator? _animator;
    private bool _hasSave;
    private int _bannersAtStart;
    private GameSettings _settings = new();
    private bool _menuOpen;
    private bool _confirmLeave;
    private bool _optionsOpen;
    private bool _rulesOpen;
    private bool _statsOpen;
    private bool _landingPoints;
    private Card? _choosing;
    private IReadOnlyList<PlayCard> _choices = [];

    protected override async Task OnInitializedAsync()
    {
        Host.CurrentChanged += OnCurrentChanged;
        Subscribe();
        _settings = await Settings.LoadAsync();
        if (!Session.IsStarted)
        {
            _hasSave = await Host.Local.HasSavedGameAsync();
        }
    }

    private RenderFragment SeatAt(PlayerView view, int position)
    {
        var seat = GameText.AtPosition(Session.Me, position);
        return @<SeatView Seat="seat" Position="position" Name="@Session.SeatName(seat)"
                          CardCount="view.HandCounts[seat.Index]" IsTurn="view.ToPlay == seat" IsDealer="view.Dealer == seat"
                          Declarations="view.Declarations.Where(d => d.Seat == seat)" />;
    }

    // The table keeps its size: its cards shrink to fit (.table in app.css). For 1–4 rows of cards, the columns needed.
    private static string TableFit(int count)
    {
        var n = Math.Max(count, 1);
        return $"--c1: {n}; --c2: {(n + 1) / 2}; --c3: {(n + 2) / 3}; --c4: {(n + 3) / 4}";
    }

    private void Subscribe()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnSessionChanged;
            _subscribed.Animator = null;
        }

        _subscribed = Session;
        _subscribed.Changed += OnSessionChanged;
        _subscribed.Animator = _animator ??= new JsMoveAnimator(JS); // card plays fly over this page
        _bannersAtStart = Session.BannerCount; // no banner for plays replayed on resume
    }

    private void OnCurrentChanged()
    {
        Subscribe();
        InvokeAsync(StateHasChanged);
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private static bool CanPlay(IReadOnlyList<Command> legal, Card card) =>
        legal.OfType<PlayCard>().Any(p => p.Card == card);

    private async Task OnCardClickAsync(Card card)
    {
        var options = Session.LegalCommands.OfType<PlayCard>().Where(p => p.Card == card).ToList();
        if (options.Count == 1)
        {
            await Session.PlayAsync(options[0]);
        }
        else if (options.Count > 1)
        {
            _choosing = card; // P3: the player chooses the capture
            _choices = options;
        }
    }

    private async Task ChooseAsync(PlayCard play)
    {
        CancelChoice();
        await Session.PlayAsync(play);
    }

    private void CancelChoice()
    {
        _choosing = null;
        _choices = [];
    }

    // Closing the round summary: the end-of-round points fly from the table to the scores, then the game goes on.
    private async Task CloseSummaryAsync()
    {
        var session = Session;
        if (_landingPoints || session.PendingSummary is not { } scored)
        {
            return;
        }

        var gains = PointsGain.ForRound(scored, session.Me.Team);
        if (gains.Count > 0 && _animator is { } animator)
        {
            _landingPoints = true;
            StateHasChanged();
            await Task.Yield(); // let the summary disappear before the points start
            try
            {
                await animator.PointsAsync(gains);
            }
            finally
            {
                _landingPoints = false;
            }
        }

        await session.AcknowledgeSummaryAsync();
    }

    private async Task NewGameAsync()
    {
        if (!Session.IsStarted && _hasSave)
        {
            await Stats.RecordAbandonAsync(); // the saved match is replaced
        }

        ulong seed = ulong.TryParse(SeedParameter, System.Globalization.CultureInfo.InvariantCulture, out var requested)
            ? requested
            : (ulong)Random.Shared.NextInt64(long.MaxValue);
        SeedParameter = null; // "Nuova partita" after the end gets a fresh deal
        var local = Host.Local;
        _bannersAtStart = 0;
        await local.NewGameAsync(seed, _settings.Difficulty);
    }

    private async Task ResumeAsync()
    {
        if (await Host.Local.TryResumeAsync())
        {
            _bannersAtStart = Host.Local.BannerCount;
        }
        else
        {
            _hasSave = false;
        }
    }

    private void CloseMenu()
    {
        _menuOpen = false;
        _confirmLeave = false;
    }

    private async Task SaveSettingsAsync(GameSettings settings)
    {
        _settings = settings;
        await Settings.SaveAsync(settings);
    }

    private async Task LeaveAsync()
    {
        CloseMenu();
        CancelChoice();
        if (Session.IsStarted && Session.Result is null)
        {
            await Stats.RecordAbandonAsync();
        }

        await Session.LeaveAsync();
        Host.UseOffline();
        _hasSave = await Host.Local.HasSavedGameAsync();
    }

    public void Dispose()
    {
        Host.CurrentChanged -= OnCurrentChanged;
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnSessionChanged;
            _subscribed.Animator = null;
        }
    }
}
