@page "/online"
@using Spincio.Client.Game
@using Spincio.Contracts
@implements IDisposable
@inject OnlineService OnlineGames
@inject ILobby Lobby
@inject ProfileService Profiles
@inject GameHost Host
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Spincio online</PageTitle>

<section class="start online">
    <h1>Online</h1>

    @if (OnlineGames.ServerUrl is null)
    {
        <p>Per giocare con gli amici serve un server acceso. Chi ospita la partita avvia il server e crea la stanza, poi manda il <strong>link di invito</strong>: chi lo apre è già collegato.</p>
        <label class="field">
            Indirizzo del server
            <input @bind="_serverInput" @bind:event="oninput" placeholder="https://…" inputmode="url" autocapitalize="off" spellcheck="false" />
        </label>
        <button type="button" class="primary" disabled="@(OnlineService.Parse(_serverInput) is null)" @onclick="UseServerAsync">Collega</button>
        @if (_badServer)
        {
            <p class="error">Indirizzo non valido: deve iniziare con https://</p>
        }
    }
    else
    {
        @if (Room is { } room)
        {
            <p class="room-line">Stanza <strong class="room-code">@room.Code</strong></p>
            <ol class="seats">
                @foreach (var seat in room.Seats)
                {
                    <li>
                        @(seat.Seat % 2 == 0 ? "Squadra A" : "Squadra B") ·
                        @(string.IsNullOrEmpty(seat.Name) ? "libero (CPU)" : seat.Name)
                        @(seat.Seat == Session.Me.Index ? " (tu)" : "")
                    </li>
                }
            </ol>
            <button type="button" class="primary" disabled="@_busy" @onclick="StartAsync">Inizia la partita</button>
        }
        @if (Room is null || _profile is not { HasName: true })
        {
            <label class="field">
                Il tuo nome
                <input @bind="_name" @bind:event="oninput" @onchange="SaveNameAsync" maxlength="16" placeholder="Nome" autocomplete="nickname" />
            </label>
        }

        <h2 class="online-title">Giocatori online</h2>
        @if (LobbyStatus is { } status)
        {
            <p class="lobby-status">@status</p>
        }
        @if (Others.Count > 0)
        {
            <ul class="online-players">
                @foreach (var player in Others)
                {
                    <li>
                        <span class="player-name">@player.Name</span>
                        @if (Lobby.Sent.TryGetValue(player.Id, out var sent))
                        {
                            <span class="invite-status">@sent</span>
                        }
                        @if (Room is null || sent != InviteStatus.Accepted)
                        {
                            <button type="button" class="invite-player" disabled="@(!CanInvite)" @onclick="() => InvitePlayerAsync(player)">Invita</button>
                        }
                    </li>
                }
            </ul>
        }

        @if (Room is null)
        {
            <h2 class="online-title">Oppure con un codice</h2>
            <p class="online-hint">Crea una stanza e manda il codice, oppure entra con il codice di un amico. I posti vuoti vanno alla CPU.</p>
            <button type="button" class="primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_name))" @onclick="CreateAsync">Crea una stanza</button>
            <label class="field">
                Codice stanza
                <input @bind="_code" @bind:event="oninput" maxlength="5" placeholder="ABCDE" class="code" />
            </label>
            <button type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name))" @onclick="JoinAsync">Entra</button>
        }
        else
        {
            <p class="online-hint">Oppure manda il link di invito: chi lo apre entra in stanza. I primi due sono compagni di squadra.</p>
            <button type="button" class="btn btn-green" @onclick="InviteAsync">📨 Invita con un link</button>
            <input class="invite-link" readonly value="@InviteLink" aria-label="Link di invito" onfocus="this.select()" />
            @if (_inviteNote is { } note)
            {
                <p class="invite-note">@note</p>
            }
        }
    }

    @if (_connectionError)
    {
        <p class="error">Server non raggiungibile. Se è un server temporaneo forse è spento: chiedi un nuovo link a chi ospita.</p>
    }
    else if (OnlineGames.ServerUrl is not null && Session.Error is { } error)
    {
        <p class="error">@error</p>
    }

    @if (OnlineGames.ServerUrl is { } server && Room is null)
    {
        <p class="server-info">Server: @server.Host · <button type="button" class="link" @onclick="ForgetServerAsync">cambia</button></p>
    }

    <a class="button-link" href="">Torna al gioco offline</a>
</section>

@code {
    /// <summary>Invite links (ADR 0014): <c>online?server=https://…&amp;room=ABCDE</c>.</summary>
    [SupplyParameterFromQuery(Name = "server")] public string? ServerParameter { get; set; }

    [SupplyParameterFromQuery(Name = "room")] public string? RoomParameter { get; set; }

    private string _name = "";
    private string _code = "";
    private string _serverInput = "";
    private bool _busy;
    private bool _connectionError;
    private bool _badServer;
    private string? _inviteNote;
    private bool _subscribed;
    private PlayerProfile? _profile;

    private string InviteLink => Room is null || OnlineGames.ServerUrl is null
        ? ""
        : OnlineService.InviteLink(Navigation.BaseUri, OnlineGames.ServerUrl, Room.Code);

    private RemoteGameSession Session => OnlineGames.Session;

    private RoomInfo? Room => OnlineGames.ServerUrl is null ? null : Session.Room;

    /// <summary>The players online (ADR 0015), this device left out.</summary>
    private IReadOnlyList<OnlinePlayer> Others => [.. Lobby.Players.Where(p => p.Id != Lobby.MyId)];

    // Inviting creates the room first if needed; a room with every seat taken by a person cannot take anyone else.
    private bool CanInvite => !_busy && Lobby.State == LobbyState.Online
        && (Room is null ? !string.IsNullOrWhiteSpace(_name) : !Room.Started && Room.Seats.Any(s => string.IsNullOrEmpty(s.Name)));

    private string? LobbyStatus => Lobby.State switch
    {
        _ when _profile is not { HasName: true } => "Scrivi il tuo nome: comparirai nella lista e vedrai chi è online.",
        LobbyState.Off or LobbyState.Connecting => "Collegamento al server…",
        LobbyState.Unreachable => "Server non raggiungibile: riprovo tra poco.",
        _ when Others.Count == 0 => "Per ora non c'è nessun altro. Qui compare chi apre l'app collegata a questo server.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        await OnlineGames.LoadAsync();
        if (!string.IsNullOrWhiteSpace(ServerParameter))
        {
            _badServer = !await OnlineGames.UseServerAsync(ServerParameter);
        }

        if (!string.IsNullOrWhiteSpace(RoomParameter))
        {
            _code = RoomParameter.Trim().ToUpperInvariant();
        }

        _profile = await Profiles.LoadAsync();
        _name = _profile.Name;
        Lobby.Changed += OnLobbyChanged;
        await StartLobbyAsync();
        await ConnectAsync();
    }

    private async Task StartLobbyAsync()
    {
        if (OnlineGames.ServerUrl is { } server && _profile is { HasName: true } profile)
        {
            await Lobby.StartAsync(server, profile);
        }
    }

    private async Task SaveNameAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || _name.Trim() == _profile?.Name)
        {
            return;
        }

        _profile = await Profiles.SetNameAsync(_name);
        await StartLobbyAsync();
    }

    private async Task InvitePlayerAsync(OnlinePlayer player)
    {
        _busy = true;
        try
        {
            if (Room is null)
            {
                await SaveNameAsync();
                if (!(await Session.CreateRoomAsync(_name)).Ok)
                {
                    return;
                }
            }

            if (Session.SeatToken is { } token)
            {
                await Lobby.InviteAsync(player, token);
            }

            _connectionError = false;
        }
        catch (Exception)
        {
            _connectionError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConnectAsync()
    {
        if (OnlineGames.ServerUrl is null || _subscribed)
        {
            return;
        }

        _subscribed = true;
        Session.Changed += OnChanged;
        if (Session.Room is null && !Session.IsStarted)
        {
            // Back to a match or lobby left open earlier (the seat token is remembered in this browser).
            await Busy(async () => await Session.TryRejoinAsync());
        }
    }

    private async Task UseServerAsync()
    {
        _badServer = !await OnlineGames.UseServerAsync(_serverInput);
        await StartLobbyAsync();
        await ConnectAsync();
    }

    private async Task ForgetServerAsync()
    {
        Unsubscribe();
        _connectionError = false;
        await Lobby.StopAsync();
        await OnlineGames.ForgetServerAsync();
    }

    // Phones open the share sheet (WhatsApp, Messaggi…); elsewhere the link is copied.
    private async Task InviteAsync()
    {
        var link = InviteLink;
        try
        {
            await JS.InvokeVoidAsync("navigator.share", new { title = "Spincio", text = $"Gioca a Spincio con me! Stanza {Room?.Code}", url = link });
            _inviteNote = null;
            return;
        }
        catch (JSException)
        {
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", link);
            _inviteNote = "Link copiato: incollalo in un messaggio.";
        }
        catch (JSException)
        {
            _inviteNote = "Copia il link qui sopra e mandalo agli amici.";
        }
    }

    private async Task CreateAsync()
    {
        await SaveNameAsync();
        await Busy(() => Session.CreateRoomAsync(_name));
    }

    private async Task JoinAsync()
    {
        await SaveNameAsync();
        await Busy(() => Session.JoinRoomAsync(_code.Trim().ToUpperInvariant(), _name));
    }

    private async Task StartAsync() => await Busy(() => Session.StartMatchAsync());

    private async Task Busy<T>(Func<Task<T>> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        catch (Exception)
        {
            // Server unreachable: stay on the form. The server's own refusals come through Session.Error.
            _busy = false;
            _connectionError = true;
            StateHasChanged();
            return;
        }

        _connectionError = false;

        _busy = false;
        EnterIfStarted();
    }

    private bool EnterIfStarted()
    {
        if (!Session.IsStarted)
        {
            return false;
        }

        Host.UseOnline(Session);
        Navigation.NavigateTo("");
        return true;
    }

    private void OnChanged() => InvokeAsync(() =>
    {
        if (!EnterIfStarted())
        {
            StateHasChanged();
        }
    });

    private void Unsubscribe()
    {
        if (_subscribed && OnlineGames.ServerUrl is not null)
        {
            Session.Changed -= OnChanged;
        }

        _subscribed = false;
    }

    private void OnLobbyChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Lobby.Changed -= OnLobbyChanged;
        Unsubscribe();
    }
}
