@using Spincio.Client.Game
@* A card: image from the Piacentine scan (ADR 0011). Interactive only when OnClick is bound. *@
@if (Card is { } card && !FaceDown)
{
    var css = $"card suit-{card.Suit.ToString().ToLowerInvariant()} {(Small ? "small" : "")} {(Highlighted ? "highlighted" : "")} {(Playable ? "playable" : "")}";
    if (OnClick.HasDelegate)
    {
        <button type="button" class="@css" data-card="@card" disabled="@(!Playable)" title="@GameText.CardName(card)" aria-label="@GameText.CardName(card)"
                @onclick="() => OnClick.InvokeAsync(card)">
            <CardFace Card="card" />
        </button>
    }
    else
    {
        <span class="@css" data-card="@card" role="img" title="@GameText.CardName(card)" aria-label="@GameText.CardName(card)">
            <CardFace Card="card" />
        </span>
    }
}
else
{
    <span class="card back @(Small ? "small" : "")" aria-hidden="true"></span>
}

@code {
    [Parameter] public Card? Card { get; set; }
    [Parameter] public bool FaceDown { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public bool Highlighted { get; set; }
    [Parameter] public bool Playable { get; set; }
    [Parameter] public EventCallback<Card> OnClick { get; set; }
}
