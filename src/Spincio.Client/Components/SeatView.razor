@using Spincio.Client.Game
@* Another seat at the table. Position is relative to the viewer: 1 = right, 2 = across (partner), 3 = left. *@
<div class="seat seat-@Position @(IsTurn ? "turn" : "")">
    <div class="seat-name">@Name@if (IsDealer) {<small>mazziere</small>}</div>
    <div class="seat-cards">
        @for (int i = 0; i < CardCount; i++)
        {
            <CardView FaceDown="true" Small="true" />
        }
    </div>
    @if (Declarations.Any())
    {
        <div class="seat-badges">
            @foreach (var d in Declarations)
            {
                <div class="badge" title="@GameText.DeclarationName(d.Kind)">Accuso +@d.Points</div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Seat Seat { get; set; }
    [Parameter] public int Position { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int CardCount { get; set; }
    [Parameter] public bool IsTurn { get; set; }
    [Parameter] public bool IsDealer { get; set; }
    [Parameter] public IEnumerable<DeclarationRecord> Declarations { get; set; } = [];
}
