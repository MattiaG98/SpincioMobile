@* Card face: one image per card, cut from the full-deck scan of traditional Piacentine cards on Wikimedia Commons
   (ADR 0011, CREDITS.md). Files are named with the card notation, e.g. cards/7D.webp. *@
<img class="face" src="cards/@(Card).webp" alt="" draggable="false" loading="eager" decoding="async" />

@code {
    [Parameter, EditorRequired] public Card Card { get; set; }
}
