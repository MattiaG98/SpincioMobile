@using Spincio.Client.Game
@using static Spincio.Client.Components.PiacentineLayout
@* Card face in the traditional Piacentine style, drawn from scratch for Spincio (ADR 0011): curved interlaced swords,
   crossed clubs, ornate coins and goblets, full-length figures. A small corner index keeps cards readable on phones. *@
<svg class="face" viewBox="0 0 60 90" aria-hidden="true" focusable="false">
    <rect class="paper" x="1" y="1" width="58" height="88" rx="5" />
    <rect class="frame" x="3.5" y="3.5" width="53" height="83" rx="3" />

    @if (Card.Rank == Rank.Ace)
    {
        @Ace(Card.Suit)
    }
    else if (Card.Rank <= Rank.Seven)
    {
        var count = (int)Card.Rank;
        switch (Card.Suit)
        {
            case Suit.Swords:
                @Swords(count)
                break;
            case Suit.Clubs:
                @Clubs(count)
                break;
            default:
                foreach (var (x, y) in Pips[count])
                {
                    <SuitGlyph Suit="Card.Suit" X="x" Y="y" Size="@(Card.Suit == Suit.Cups ? 17 : 15)" />
                }
                break;
        }
    }
    else
    {
        <PiacentineFigure Rank="Card.Rank" Suit="Card.Suit" />
    }

    <text class="index" x="8" y="12.5">@GameText.RankLabel(Card.Rank)</text>
</svg>

@code {
    [Parameter, EditorRequired] public Card Card { get; set; }

    private static RenderFragment Hilt(double y) =>
        @<g class="art">
            <rect x="25.5" y="@F($"{y - 0.3}")" width="9" height="1.6" rx="0.8" class="p-yellow" />
            <rect x="29" y="@F($"{y + 1.3}")" width="2" height="3" class="p-red" />
            <circle cx="30" cy="@F($"{y + 5.2}")" r="1.3" class="p-yellow" />
        </g>;

    private static RenderFragment CurvedSword(double bow, int level) => __builder =>
    {
        var (tip, hilt) = SwordSpan(level);
        <g class="art">
            <path class="p-blue" d="@CurvedBlade(bow, tip, hilt)" />
        </g>
        @Hilt(hilt)
    };

    private static RenderFragment Swords(int count) => __builder =>
    {
        var bows = SwordBows(count);
        for (var level = 0; level < bows.Count; level++)
        {
            var bow = bows[level];
            var depth = level;
            @CurvedSword(bow, depth)
            <g transform="rotate(180 30 45)">@CurvedSword(bow, depth)</g>
        }

        if (HasStraightCentre(count))
        {
            <g class="art"><path class="p-blue" d="M28.9,74 L28.9,16 L30,11 L31.1,16 L31.1,74 Z" /></g>
            @Hilt(74)
        }
    };

    private static RenderFragment Club(double x, double y, double angle, double half) =>
        @<g class="art" transform="@F($"translate({x} {y}) rotate({angle})")">
            <path class="p-green" d="@PiacentineLayout.Club(half)" />
            <ellipse cy="@F($"{-half + 4}")" rx="2.9" ry="0.9" class="p-yellow" />
            <ellipse cy="@F($"{half - 1.5}")" rx="2" ry="0.7" class="p-yellow" />
            <circle cx="-2.4" cy="@F($"{-half * 0.45}")" r="1" class="p-red" />
            <circle cx="2.2" cy="0" r="1" class="p-red" />
            <circle cx="-2.1" cy="@F($"{half * 0.45}")" r="0.9" class="p-red" />
        </g>;

    private static RenderFragment Clubs(int count) => __builder =>
    {
        foreach (var offset in ClubOffsets(count))
        {
            @Club(CenterX + offset, CenterY, ClubAngle, 34)
            @Club(CenterX + offset, CenterY, -ClubAngle, 34)
        }

        if (HasStraightCentre(count))
        {
            @Club(CenterX, CenterY, 0, 34)
        }
    };

    private static RenderFragment Ace(Suit suit) => __builder =>
    {
        switch (suit)
        {
            case Suit.Coins:
                <circle class="ace-ring" cx="30" cy="45" r="22" />
                <SuitGlyph Suit="suit" X="30" Y="45" Size="38" />
                break;
            case Suit.Cups:
                <SuitGlyph Suit="suit" X="30" Y="47" Size="46" />
                break;
            case Suit.Swords:
                <g class="art">
                    <path class="p-blue" d="M27.4,70 L27.4,20 L30,9 L32.6,20 L32.6,70 Z" />
                    <path class="ribbon" d="M22,30 C30,24 38,36 30,40 C22,44 30,56 38,50" />
                    <rect x="20" y="69.5" width="20" height="2.6" rx="1.3" class="p-yellow" />
                    <rect x="28.4" y="72.1" width="3.2" height="6" class="p-red" />
                    <circle cx="30" cy="80.5" r="2.4" class="p-yellow" />
                </g>
                break;
            default:
                @Club(30, 46, -10, 36)
                <path class="ribbon" d="M19,40 C26,33 34,49 42,40" />
                break;
        }
    };
}
