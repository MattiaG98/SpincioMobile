@* Suit symbols in the traditional Piacentine style, drawn from scratch for Spincio (ADR 0009, ADR 0011).
   Coordinates are centred on (X, Y); Size is the height. Colours come from the p-* classes in app.css. *@
@{
    var s = Size / 20.0;
    var transform = FormattableString.Invariant($"translate({X} {Y}) scale({s}) rotate({Rotate})");
}
<g transform="@transform" class="art">
    @switch (Suit)
    {
        case Suit.Coins:
            <circle r="9.6" class="p-yellow" />
            <circle r="7.4" class="p-red" />
            <circle r="5.6" class="p-yellow" />
            @for (var i = 0; i < 8; i++)
            {
                <ellipse cy="-2.7" rx="1.25" ry="2.4" class="@(i % 2 == 0 ? "p-green" : "p-blue")" transform="rotate(@(i * 45))" />
            }
            <circle r="1.3" class="p-red" />
            break;
        case Suit.Cups:
            <path class="p-yellow" d="M-7.5,-8 C-7.5,-1 -3.5,2 0,2 C3.5,2 7.5,-1 7.5,-8 Z" />
            <path class="p-red" d="M-7.2,-5.4 H7.2 C7,-4.5 6.8,-4 6.6,-3.6 H-6.6 C-6.8,-4 -7,-4.5 -7.2,-5.4 Z" />
            <ellipse cy="-8" rx="7.5" ry="1.6" class="p-red" />
            <rect x="-1.2" y="2" width="2.4" height="4.2" class="p-blue" />
            <ellipse cy="4" rx="2.4" ry="1.1" class="p-yellow" />
            <path class="p-red" d="M-5,9.4 L-1.8,6.2 H1.8 L5,9.4 Z" />
            <ellipse cy="9.4" rx="5" ry="0.8" class="p-red" />
            break;
        case Suit.Swords:
            <path class="p-blue" d="M0,-10 C1.5,-6 1.6,0 1.3,5 H-1.3 C-1.6,0 -1.5,-6 0,-10 Z" />
            <rect x="-5" y="5" width="10" height="1.6" rx="0.8" class="p-yellow" />
            <rect x="-1" y="6.6" width="2" height="2.4" class="p-red" />
            <circle cy="9.6" r="1.1" class="p-yellow" />
            break;
        default:
            <g transform="rotate(-15)">
                <path class="p-green" d="M-1.6,10 L-2.8,-7 C-3,-10.5 3,-10.5 2.8,-7 L1.6,10 Z" />
                <ellipse cy="-6.6" rx="2.8" ry="0.8" class="p-yellow" />
                <circle cx="-2.2" cy="-3" r="0.9" class="p-red" />
                <circle cx="2.1" cy="1" r="0.9" class="p-red" />
                <circle cx="-1.8" cy="5" r="0.8" class="p-red" />
            </g>
            break;
    }
</g>

@code {
    [Parameter, EditorRequired] public Suit Suit { get; set; }
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public double Size { get; set; } = 20;
    [Parameter] public double Rotate { get; set; }
}
