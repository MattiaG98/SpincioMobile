@using static Spincio.Client.Components.PiacentineLayout
@* Full-length court figures (Fante, Cavallo, Re) in the Piacentine spirit, drawn from scratch for Spincio (ADR 0011).
   Each holds the symbol of its suit; robe colours change with the suit. *@
@{
    var (primary, secondary) = Colours(Suit);
}
<g class="art figure">
    @switch (Rank)
    {
        case Rank.Jack:
            <ellipse cx="26" cy="82.5" rx="2.6" ry="1.1" class="p-ink" />
            <ellipse cx="34" cy="82.5" rx="2.6" ry="1.1" class="p-ink" />
            <rect x="24.6" y="66" width="3.4" height="16" class="@secondary" />
            <rect x="32" y="66" width="3.4" height="16" class="@secondary" />
            <path class="@secondary" d="M22,40 L18,56 L21,57 L24.5,44 Z" />
            <circle cx="19.5" cy="57.4" r="1.6" class="p-skin" />
            <path class="@primary" d="M22,39 L38,39 L41,68 L19,68 Z" />
            <path class="p-yellow" d="M19,68 L41,68 L40.6,65 L19.4,65 Z" />
            <rect x="21.2" y="52" width="17.6" height="2" class="p-yellow" />
            <path class="p-yellow" d="M25,39 L30,44 L35,39 Z" />
            <path class="@secondary" d="M38,40 L43,47 L40.5,49 L36,44 Z" />
            <circle cx="42.4" cy="48" r="1.6" class="p-skin" />
            @Head(30, 31, 4.6)
            <path class="p-hair" d="M25.4,31 C25,25 35,25 34.6,31 C33.5,28.5 26.5,28.5 25.4,31 Z" />
            <path class="@secondary" d="M24.5,27.6 C25,22 35,22 35.5,27.6 Z" />
            <path class="p-yellow" d="M35,25 C38.5,19.5 41.5,21 38,26 Z" />
            @Held(44, 40)
            break;

        case Rank.Knight:
            <path class="p-hair" d="M43.5,57 C49,60 49,68 46,73 C45.5,67 44.5,62 42,60 Z" />
            @for (var i = 0; i < 4; i++)
            {
                var x = new[] { 18.5, 22.5, 34.5, 38.5 }[i];
                <rect x="@F($"{x}")" y="63" width="2.6" height="18" class="p-horse" />
                <rect x="@F($"{x}")" y="80" width="2.6" height="1.8" class="p-ink" />
            }
            <ellipse cx="29" cy="60" rx="15" ry="8" class="p-horse" />
            <path class="p-horse" d="M18,58 L14.5,47 C13.5,44.5 12.5,43 10.5,43 L7.5,45.5 L6.2,44 L8.5,38.8 L9.5,35.8 L11,38 C14,37.6 17.5,39 19.5,42 L23,49 L22.5,56 Z" />
            <path class="@secondary" d="M11,38 C15,38.5 19,41 21.5,46.5 L23,55 L21.2,55 C20.5,50 19,44.5 14,40.5 Z" />
            <circle cx="10.6" cy="40.6" r="0.55" class="p-ink" />
            <path class="@primary" d="M24,53 L37,53 L38,64 L23,64 Z" />
            <rect x="23" y="62.4" width="15" height="1.6" class="p-yellow" />
            <path class="@secondary" d="M29,54 L31.2,54 L32.2,68 L29.6,68 Z" />
            <ellipse cx="31.2" cy="68.8" rx="2.2" ry="1" class="p-ink" />
            <path class="@primary" d="M25.5,38 L21,46 L23,47.5 L27,42 Z" />
            <circle cx="21.6" cy="46.8" r="1.4" class="p-skin" />
            <path class="@primary" d="M25,37 L35,37 L36,55 L24,55 Z" />
            <rect x="24.5" y="48.5" width="11" height="1.8" class="p-yellow" />
            <path class="@primary" d="M34.5,38 L40,45 L38,47 L33,42 Z" />
            <circle cx="39.4" cy="46" r="1.4" class="p-skin" />
            @Head(30, 31.5, 4.3)
            <path class="@secondary" d="M24.8,29 C25.2,23.5 34.8,23.5 35.2,29 Z" />
            <ellipse cx="30" cy="29" rx="6.6" ry="1.2" class="@secondary" />
            @Held(41, 38)
            break;

        default:
            <path class="@secondary" d="M21,40 C15,50 15,70 17,83 L20,83 C19,68 20,52 25,42 Z" />
            <path class="@secondary" d="M39,40 C45,50 45,70 43,83 L40,83 C41,68 40,52 35,42 Z" />
            <path class="@primary" d="M21,40 L39,40 L42,83 L18,83 Z" />
            <rect x="28" y="44" width="4" height="36" class="@secondary" />
            <path class="p-yellow" d="M18,83 L42,83 L41.7,80 L18.3,80 Z" />
            <path class="@primary" d="M23,41 L20,55 L23,56 L26,45 Z" />
            <circle cx="21.4" cy="56.3" r="1.6" class="p-skin" />
            <path class="@primary" d="M37,41 L42,49 L39.5,51 L35,45 Z" />
            <circle cx="41.4" cy="50" r="1.6" class="p-skin" />
            <path class="p-white" d="M22,40 C26,45.5 34,45.5 38,40 C34,42.5 26,42.5 22,40 Z" />
            @Head(30, 32, 4.8)
            <path class="p-hair" d="M25.4,33 C25.8,39.5 34.2,39.5 34.6,33 C33,35.6 27,35.6 25.4,33 Z" />
            <path class="p-yellow" d="M24.8,28.6 L24.8,22.5 L27.2,25.5 L30,21.5 L32.8,25.5 L35.2,22.5 L35.2,28.6 Z" />
            <rect x="24.8" y="26.6" width="10.4" height="2" class="p-red" />
            @Held(43, 42)
            break;
    }
</g>

@code {
    [Parameter, EditorRequired] public Rank Rank { get; set; }
    [Parameter, EditorRequired] public Suit Suit { get; set; }

    private static (string Primary, string Secondary) Colours(Suit suit) => suit switch
    {
        Suit.Coins => ("p-red", "p-blue"),
        Suit.Cups => ("p-blue", "p-red"),
        Suit.Swords => ("p-red", "p-green"),
        _ => ("p-green", "p-red"),
    };

    private static RenderFragment Head(double x, double y, double r) =>
        @<g>
            <rect x="@F($"{x - 1.4}")" y="@F($"{y + r - 1}")" width="2.8" height="4" class="p-skin" />
            <circle cx="@F($"{x}")" cy="@F($"{y}")" r="@F($"{r}")" class="p-skin" />
            <circle cx="@F($"{x - 1.7}")" cy="@F($"{y}")" r="0.45" class="p-ink" />
            <circle cx="@F($"{x + 1.7}")" cy="@F($"{y}")" r="0.45" class="p-ink" />
        </g>;

    /// <summary>The suit symbol held up by the figure, centred near (x, y).</summary>
    private RenderFragment Held(double x, double y) => Suit switch
    {
        Suit.Swords => @<SuitGlyph Suit="Suit" X="x" Y="y - 4" Size="22" />,
        Suit.Clubs => @<SuitGlyph Suit="Suit" X="x" Y="y - 3" Size="22" Rotate="25" />,
        _ => @<SuitGlyph Suit="Suit" X="x" Y="y" Size="13" />,
    };
}
